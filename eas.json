{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      }
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://dashboard.fasttrackscarcare.in/api/v1"
      }
    },
    "production": {
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_API_URL": "https://dashboard.fasttrackscarcare.in/api/v1"
      }
    },
    "development-voip": {
      "extends": "development",
      "env": {
        "FASTTRACKS_VOIP_NATIVE": "1",
        "EXPO_PUBLIC_VOIP_NATIVE": "true"
      }
    },
    "development-dialer": {
      "extends": "development",
      "env": {
        "FASTTRACKS_DIALER": "1"
      }
    },
    "sales-trial": {
      "distribution": "internal",
      "autoIncrement": false,
      "android": {
        "buildType": "apk"
      },
      "env": {
        "FASTTRACKS_DIALER": "1",
        "FASTTRACKS_TRIAL": "1",
        "EXPO_PUBLIC_API_URL": "https://REPLACE-WITH-STAGING-HOST.invalid/api/v1"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
